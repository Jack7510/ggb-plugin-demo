    },
    {
      "id": "midpointRelation",
      "requirement": "geometry",
      "kind": "boolean",
      "expression": "AreEqual(M,Midpoint(A,B))"
    },
    {
      "id": "nondegenerate",
      "requirement": "geometry",
      "kind": "boolean",
      "expression": "Area(tri)>0"
