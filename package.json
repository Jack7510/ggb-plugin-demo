{
  "name": "ggb-plugin-demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "cli": "node dist/src/cli.js",
    "smoke:browser": "node scripts/browser_smoke.mjs",
    "setup:runtime": "node scripts/setup_runtime.mjs",
    "experiment:triangle": "pnpm build && node dist/src/experiment.js",
    "lint": "gts lint 'src/**/*.ts' 'tests/**/*.ts' 'scripts/*.mjs' 'viewer/*.js' eslint.config.js -- --max-warnings=0",
    "fix": "gts fix 'src/**/*.ts' 'tests/**/*.ts' 'scripts/*.mjs' 'viewer/*.js' eslint.config.js",
    "demo:counterexample": "tsc -p tsconfig.json && node dist/src/demo_counterexample.js",
    "demo:drag-video": "tsc -p tsconfig.json && node dist/src/drag_diagnostic.js",
    "check:skill": "tsc -p tsconfig.json && node scripts/check_skill.mjs",
    "pack:codex": "pnpm build && node scripts/pack_codex.mjs",
    "setup:plugin": "node scripts/setup-plugin.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "gts": "7.0.0",
    "typescript": "6.0.3"
  }
}
